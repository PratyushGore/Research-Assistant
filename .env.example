# =====================================================================
# Multi-Agent AI Research & Publication Assistant - Environment Config
# =====================================================================

# Google Gemini API key for LLM generation, synthesis, verification, and user Q&A (Required)
GEMINI_API_KEY=

# Gemini model variant to use across LLM client calls
GEMINI_MODEL=gemini-3.5-flash-lite

# Semantic Scholar API key for enhanced search rate limits (Optional)
S2_API_KEY=

# CORE repository API key for academic paper search (Optional)
CORE_API_KEY=

# Document depth for composer generation: "extended" (thorough) or "brief" (concise)
DOC_DEPTH=extended

# Maximum concurrent worker threads for verification agent claims checks
VERIFY_MAX_WORKERS=4

# Maximum allowed PDF file size in MB for ingestion download
INGEST_MAX_PDF_MB=2.0

# Download timeout in seconds for fetching full-text paper PDFs
INGEST_DOWNLOAD_TIMEOUT_S=60

# Local cache directory path for downloaded PDF papers
RA_PDF_CACHE_DIR=.cache/pdf

# Local cache directory path for LLM response caching
RA_CACHE_DIR=.cache/llm

# Local cache directory path for academic search results
SEARCH_CACHE_DIR=.cache/search
